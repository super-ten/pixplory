  "entries": [
    {
      "id": "3dfd78b2-058f-4cdd-a652-5de60022f50d",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "LLM",
      "intl": "Large Language Model",
      "cn": "大語言模型",
      "description": "以大規模文本與多模態資料訓練的生成式模型，根據上下文預測後續 Token。擅長語言理解、生成與推理，但輸出仍可能出錯，需配合檢索、工具與評測使用。",
      "sort_order": 0,
      "revision": 1
    },
    {
      "id": "0f1e984c-5eb2-4205-8380-6b253b92238c",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Agent",
      "intl": "AI Agent",
      "cn": "智能體",
      "description": "以模型為決策核心，能感知上下文、規劃步驟、調用工具並根據結果繼續行動的軟件系統。Agent 不等於模型本身，其可靠性取決於權限、工具、記憶、評測與人工監督。",
      "sort_order": 1,
      "revision": 1
    },
    {
      "id": "f22a9531-a1bb-4a67-aef2-65fbec0f0566",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Skills",
      "intl": "Agent Skills / Toolsets",
      "cn": "技能 / 工具集",
      "description": "可重用的任務能力包，通常包含操作指引、工具、腳本、範本與領域知識，例如檢索資料、處理文檔或調用渲染器。Skill 規範 Agent 如何完成一類工作，而非單純等同於工具。",
      "sort_order": 2,
      "revision": 1
    },
    {
      "id": "2d34aa4e-83c5-49d1-92e9-0b0e7c7bba73",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "MCP",
      "intl": "Model Context Protocol",
      "cn": "模型上下文協議",
      "description": "一種開放協議，用標準方式讓 AI 應用連接工具、資料來源與可重用提示。它降低整合成本，但不自動保證安全或合規；權限、驗證、資料邊界與審計仍需由實作方負責。",
      "sort_order": 3,
      "revision": 1
    },
    {
      "id": "b582371c-583b-42bd-b6e0-26e9fde0980b",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "CLI",
      "intl": "Command Line Interface",
      "cn": "命令行界面",
      "description": "以文字命令與程式互動的介面，便於自動化、批次處理與組合工具。CLI 型 Agent 只擁有使用者或沙箱授予的權限，不應預設為最高權限。",
      "sort_order": 4,
      "revision": 1
    },
    {
      "id": "c2fadd12-b417-4e4a-a002-b73e1764cb38",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "RAG",
      "intl": "Retrieval-Augmented Generation",
      "cn": "檢索增強生成",
      "description": "在生成前檢索外部資料，並把相關片段加入模型上下文，以提升時效性、可追溯性與領域覆蓋。RAG 能降低部分事實錯誤，但效果仍取決於資料品質、檢索、排序與引用驗證。",
      "sort_order": 5,
      "revision": 1
    },
    {
      "id": "0bd79829-5a7c-4b6d-8e0e-d68926cb1d93",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Vibe Coding",
      "intl": "Vibe Coding",
      "cn": "氛圍編程 / 意圖驅動編程",
      "description": "以自然語言描述意圖並快速接受、試用 AI 生成代碼的開發方式，重視迭代速度與結果體驗。適合原型探索；進入生產環境仍需理解代碼、測試、安全審查與版本控制。",
      "sort_order": 6,
      "revision": 1
    },
    {
      "id": "d9dbecf6-9229-47fa-a8d7-ff970ab326aa",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "AI-first IDE",
      "intl": "Cursor, Windsurf",
      "cn": "Trae (字節跳動)",
      "description": "將 AI 深度嵌入工作流的編輯器，支持全局代碼重構與自動構建。Trae 為目前國內極具代表性的全能選項。",
      "sort_order": 0,
      "revision": 1
    },
    {
      "id": "08e55c56-2809-4254-b0af-e953503db363",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "未來 IDE 架構",
      "intl": "Antigravity (Google)、cluade code、codex",
      "cn": "-",
      "description": "真正的 Agent-first 平台，協調多個 AI 並行工作生成交付產品。\n接入PENCIL MCP:https://www.youtube.com/watch?v=nFxPhm8e19c\n接入STITCH MCP:https://www.youtube.com/watch?v=nFxPhm8e19c\n基礎設置（skill）：https://www.douyin.com/video/7602607634130193700",
      "sort_order": 1,
      "revision": 1
    },
    {
      "id": "6cb65e00-95df-4474-a06a-cd85fb657b53",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "雲端開發環境",
      "intl": "Google AI Studio, Project IDX",
      "cn": "阿里雲百煉, 騰訊雲微搭",
      "description": "基於瀏覽器的雲端全棧開發環境或 API 調試平台，免除本地算力與環境配置的煩惱。",
      "sort_order": 2,
      "revision": 1
    },
    {
      "id": "4e66fdaf-de1f-4e26-a670-e169f75854bd",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "開源智能體",
      "intl": "OpenClaw（龙虾）、MetaGPT",
      "cn": "WorkBuddy（騰訊）",
      "description": "打破閉源壁壘的代表。MetaGPT 引入了標準作業程序(SOP)，支持多角色 AI 協同開發。",
      "sort_order": 3,
      "revision": 1
    },
    {
      "id": "ad668fbd-6d7b-4746-b541-7af221b96edf",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Diffusion Models",
      "intl": "Midjourney, Stable Diffusion",
      "cn": "可靈 (Kling)",
      "description": "擴散模型。通過噪聲預測與去除實現高保真圖像生成，重塑了視覺藝術的生產管線與審美標准。",
      "sort_order": 0,
      "revision": 1
    },
    {
      "id": "a19772fa-bb46-4417-8678-954d24a111e6",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Node-based Gen",
      "intl": "ComfyUI",
      "cn": "Liblib",
      "description": "節點式生成界面。將黑盒化的 AI 繪圖轉化為可視化的邏輯節點，賦予創作者對生成過程的極限控制力。",
      "sort_order": 1,
      "revision": 1
    },
    {
      "id": "3cf8fbce-6a25-42c8-878d-170ba069dcf3",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Spacetime Patches",
      "intl": "Sora (OpenAI)",
      "cn": "Vidu",
      "description": "時空補丁技術。將視頻降維為統一的數據切片，實現了從單幀畫面到物理世界動態模擬的跨越。",
      "sort_order": 2,
      "revision": 1
    },
    {
      "id": "786b7347-cea1-4c69-ba43-af1f20389731",
      "category_id": "e3035b1d-0ac0-4010-90dc-d52f1bc922ea",
      "term": "Remotion",
      "intl": "☑️",
      "cn": "☑️",
