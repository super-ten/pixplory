    },
    {
      "id": "c6679b22-a777-4127-9d22-b000e2099b55",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Markdown",
      "intl": "Markdown",
      "cn": "純文本標記語言",
      "description": "用簡潔符號為純文字添加標題、列表、連結與程式碼等結構的輕量標記語言，常用於 README、文檔、提示與 Agent 指令文件。不同解析器支持的擴展語法可能不同。",
      "sort_order": 7,
      "revision": 1
    },
    {
      "id": "216ae8f6-6557-4a67-b78f-ab612862cf77",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "IDE",
      "intl": "Integrated Development Environment",
      "cn": "整合開發環境",
      "description": "把程式編輯、執行、除錯、測試、版本控制與專案管理整合在同一工作環境中的軟件。AI-first IDE 會在此基礎上加入程式理解、生成與 Agent 工作流。",
      "sort_order": 8,
      "revision": 1
    },
    {
      "id": "4e1d96f3-9b0f-4ed8-b091-dbde51bf6cbf",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Workflow",
      "intl": "Workflow",
      "cn": "工作流",
      "description": "將任務拆成可追蹤的步驟、依賴、路由與規則，使人、模型和工具按條件協作。工作流可以是固定流程，也可以包含由 Agent 動態決策的分支。",
      "sort_order": 9,
      "revision": 1
    },
    {
      "id": "4b26e1f7-ec18-43b5-a05d-bb1e761f70dc",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Git",
      "intl": "Git",
      "cn": "分散式版本控制系統",
      "description": "分散式版本控制系統，用提交記錄追蹤文件變更，並以分支、合併與回退支持多人協作。可類比為帶完整差異與歷史的專案存檔系統。",
      "sort_order": 10,
      "revision": 1
    },
    {
      "id": "a7de793f-223b-4e79-bb51-9cb7088120e6",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Task",
      "intl": "Task",
      "cn": "任務",
      "description": "具有明確目標、輸入、約束與完成標準的工作單元，可由人、模型或 Agent 執行。任務列表只是管理多個 Task 的一種介面。",
      "sort_order": 11,
      "revision": 1
    },
    {
      "id": "4fe30833-6799-4392-8d9a-a1c868a0c321",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "PRD",
      "intl": "Product Requirements Document",
      "cn": "產品需求文檔",
      "description": "描述產品目標、使用者、需求範圍、流程、約束與驗收標準的文件。AI 產品的 PRD 還應明確模型邊界、資料需求、評測指標、安全風險與人工兜底。",
      "sort_order": 12,
      "revision": 1
    },
    {
      "id": "8f53f8ce-e5dc-488b-a3ab-b08429383136",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "React",
      "intl": "React",
      "cn": "React 前端函式庫",
      "description": "用元件與狀態模型構建 Web 使用者介面的 JavaScript 函式庫。React 本身不會直接生成 iOS 或 Android 原生應用；跨平台原生開發通常使用相關但獨立的 React Native。",
      "sort_order": 13,
      "revision": 1
    },
    {
      "id": "4d226b26-7964-4450-902d-8598ccaed5db",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Canvas",
      "intl": "Canvas / Visual Workspace",
      "cn": "視覺畫布 / 可視化工作區",
      "description": "以自由佈局方式組織文字、圖像、節點與連線的工作介面，適合構思、改稿和呈現關係。它是互動形態，不等同於 HTML Canvas API，也不必然包含 AI。",
      "sort_order": 14,
      "revision": 1
    },
    {
      "id": "9d0fede8-0087-4504-a0a3-e79b4e288ed5",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "FDE",
      "intl": "Forward Deployed Engineer",
      "cn": "前線部署工程師 / 駐場交付工程師",
      "description": "深入客戶現場，把通用技術產品配置、整合並迭代為可用業務方案的工程角色。核心能力涵蓋軟件工程、領域洞察、需求拆解、客戶溝通與交付閉環，並不限於 AI。",
      "sort_order": 15,
      "revision": 1
    },
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Transformer",
      "intl": "Transformer Architecture",
      "cn": "Transformer 架構",
      "description": "以注意力機制為核心的神經網絡架構，可並行處理序列並學習長距離關係，是多數現代大語言模型與多模態模型的基礎。",
      "sort_order": 16,
      "revision": 1
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Token",
      "intl": "Token",
      "cn": "詞元 / 標記",
      "description": "模型讀取與生成內容的基本計算單位，可能是一個字、詞的一部分、符號或其他資料片段。Token 數量會影響上下文容量、延遲與使用成本。",
      "sort_order": 17,
      "revision": 1
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Context Window",
      "intl": "Context Window",
      "cn": "上下文窗口",
      "description": "模型在一次請求中可共同參考的輸入與輸出 Token 範圍。窗口更大不代表模型能同等準確地使用其中所有信息，仍需良好的結構、檢索與摘要策略。",
      "sort_order": 18,
      "revision": 1
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Prompt",
      "intl": "Prompt / Instruction",
      "cn": "提示 / 指令",
      "description": "提供給模型的任務說明、上下文、約束與輸出要求。高品質提示通常明確目標、資料邊界和驗收標準，但不能取代工具權限、程式驗證與系統設計。",
      "sort_order": 19,
      "revision": 1
    },
    {
      "id": "55555555-5555-4555-8555-555555555555",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Embedding",
      "intl": "Embedding / Vector Representation",
      "cn": "嵌入向量 / 向量表徵",
      "description": "把文字、圖像或其他資料映射為數值向量，使語義相近的內容在向量空間中更接近。常用於語義搜尋、聚類、推薦與 RAG 檢索。",
      "sort_order": 20,
      "revision": 1
    },
    {
      "id": "66666666-6666-4666-8666-666666666666",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Tool Calling",
      "intl": "Tool Calling / Function Calling",
      "cn": "工具調用 / 函數調用",
      "description": "模型按預定義結構選擇工具並產生參數，由應用實際執行，再把結果返回模型。它讓模型能查資料或採取行動，但必須配合參數驗證、權限控制與確認機制。",
      "sort_order": 21,
      "revision": 1
    },
    {
      "id": "77777777-7777-4777-8777-777777777777",
