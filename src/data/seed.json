  "entries": [
    {
      "id": "3dfd78b2-058f-4cdd-a652-5de60022f50d",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "LLM",
      "intl": "Large Language Model",
      "cn": "大語言模型",
      "description": "以大規模文本與多模態資料訓練的生成式模型，根據上下文預測後續 Token。擅長語言理解、生成與推理，但輸出仍可能出錯，需配合檢索、工具與評測使用。",
      "sort_order": 0,
      "revision": 1
    },
    {
      "id": "0f1e984c-5eb2-4205-8380-6b253b92238c",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Agent",
      "intl": "AI Agent",
      "cn": "智能體",
      "description": "以模型為決策核心，能感知上下文、規劃步驟、調用工具並根據結果繼續行動的軟件系統。Agent 不等於模型本身，其可靠性取決於權限、工具、記憶、評測與人工監督。",
      "sort_order": 1,
      "revision": 1
    },
    {
      "id": "f22a9531-a1bb-4a67-aef2-65fbec0f0566",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Skills",
      "intl": "Agent Skills / Toolsets",
      "cn": "技能 / 工具集",
      "description": "可重用的任務能力包，通常包含操作指引、工具、腳本、範本與領域知識，例如檢索資料、處理文檔或調用渲染器。Skill 規範 Agent 如何完成一類工作，而非單純等同於工具。",
      "sort_order": 2,
      "revision": 1
    },
    {
      "id": "2d34aa4e-83c5-49d1-92e9-0b0e7c7bba73",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "MCP",
      "intl": "Model Context Protocol",
      "cn": "模型上下文協議",
      "description": "一種開放協議，用標準方式讓 AI 應用連接工具、資料來源與可重用提示。它降低整合成本，但不自動保證安全或合規；權限、驗證、資料邊界與審計仍需由實作方負責。",
      "sort_order": 3,
      "revision": 1
    },
    {
      "id": "b582371c-583b-42bd-b6e0-26e9fde0980b",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "CLI",
      "intl": "Command Line Interface",
      "cn": "命令行界面",
      "description": "以文字命令與程式互動的介面，便於自動化、批次處理與組合工具。CLI 型 Agent 只擁有使用者或沙箱授予的權限，不應預設為最高權限。",
      "sort_order": 4,
      "revision": 1
    },
    {
      "id": "c2fadd12-b417-4e4a-a002-b73e1764cb38",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "RAG",
      "intl": "Retrieval-Augmented Generation",
      "cn": "檢索增強生成",
      "description": "在生成前檢索外部資料，並把相關片段加入模型上下文，以提升時效性、可追溯性與領域覆蓋。RAG 能降低部分事實錯誤，但效果仍取決於資料品質、檢索、排序與引用驗證。",
      "sort_order": 5,
      "revision": 1
    },
    {
      "id": "0bd79829-5a7c-4b6d-8e0e-d68926cb1d93",
      "category_id": "087cde3a-f15f-4186-ac5d-23c5d9ae8ba5",
      "term": "Vibe Coding",
      "intl": "Vibe Coding",
      "cn": "氛圍編程 / 意圖驅動編程",
      "description": "以自然語言描述意圖並快速接受、試用 AI 生成代碼的開發方式，重視迭代速度與結果體驗。適合原型探索；進入生產環境仍需理解代碼、測試、安全審查與版本控制。",
      "sort_order": 6,
      "revision": 1
    },
    {
      "id": "d9dbecf6-9229-47fa-a8d7-ff970ab326aa",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "AI-native IDE",
      "intl": "Cursor, Windsurf",
      "cn": "Trae、Qoder、通義靈碼",
      "description": "把程式碼理解、對話、補全、跨文件修改、終端與 Agent 工作流整合進開發環境。其價值不只在生成代碼，更在於利用專案上下文完成可審查、可回退的多步變更。",
      "sort_order": 0,
      "revision": 1
    },
    {
      "id": "08e55c56-2809-4254-b0af-e953503db363",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "CLI Coding Agent",
      "intl": "Claude Code, Codex CLI, Gemini CLI",
      "cn": "命令行編程智能體",
      "description": "在終端中讀取代碼庫、編輯文件、執行命令與測試的編程 Agent。它適合自動化和遠端環境，但能力受工作目錄、沙箱、網絡與授權策略約束，不應被視為無限制接管電腦。",
      "sort_order": 1,
      "revision": 1
    },
    {
      "id": "6cb65e00-95df-4474-a06a-cd85fb657b53",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Cloud Development Environment",
      "intl": "GitHub Codespaces, Firebase Studio, Replit",
      "cn": "雲端開發環境",
      "description": "在瀏覽器或遠端容器中提供代碼、終端、預覽與部署能力的開發環境。它降低本地配置成本並提升環境一致性，但需關注休眠、資源配額、網絡延遲、資料駐留與供應商鎖定。",
      "sort_order": 2,
      "revision": 1
    },
    {
      "id": "4e66fdaf-de1f-4e26-a670-e169f75854bd",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Open-source Coding Agent",
      "intl": "OpenHands, Aider, Cline",
      "cn": "開源編程智能體",
      "description": "源碼公開、可自託管或二次開發的編程 Agent。其優勢是可審計與可定制，但模型費用、沙箱隔離、憑證管理、依賴安全與維護仍由部署者承擔。",
      "sort_order": 3,
      "revision": 1
    },
    {
      "id": "d2000001-0000-4000-8000-000000000001",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Code Completion",
      "intl": "Inline Code Completion",
      "cn": "代碼補全",
      "description": "根據游標位置、鄰近代碼與專案上下文預測下一段代碼的輔助方式。它適合局部、低延遲編寫；跨文件規劃、執行與驗證則通常需要 Agent 模式。",
      "sort_order": 4,
      "revision": 1
    },
    {
      "id": "d2000002-0000-4000-8000-000000000002",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Repository Context",
      "intl": "Codebase Indexing / Repository Context",
      "cn": "代碼庫上下文 / 索引",
      "description": "透過搜尋、符號索引、語義檢索與依賴分析，向模型提供與任務相關的文件和結構。上下文品質往往比一次塞入整個代碼庫更重要。",
      "sort_order": 5,
      "revision": 1
    },
    {
      "id": "d2000003-0000-4000-8000-000000000003",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Agent Mode",
      "intl": "Agentic Coding Workflow",
      "cn": "智能體開發模式",
      "description": "讓 AI 圍繞目標循環進行理解、規劃、修改、執行、觀察與修正的工作模式。與一次性問答相比，它能完成更長任務，也更需要檢查點、停止條件與人工覆核。",
      "sort_order": 6,
      "revision": 1
    },
    {
      "id": "d2000004-0000-4000-8000-000000000004",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Sandbox & Permissions",
      "intl": "Execution Sandbox / Permission Model",
      "cn": "執行沙箱與權限模型",
      "description": "限制 Agent 可讀寫文件、運行命令、訪問網絡與調用外部服務的安全邊界。最小權限、操作前確認和可追溯審計是生產使用的核心保障。",
      "sort_order": 7,
      "revision": 1
    },
    {
      "id": "d2000005-0000-4000-8000-000000000005",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Human-in-the-loop",
      "intl": "Human-in-the-loop Development",
      "cn": "人在迴路 / 人工覆核",
      "description": "在需求澄清、方案選擇、高風險操作與合併發布等節點保留人工判斷。目標不是逐步干預，而是在最關鍵的位置建立可驗證的控制點。",
      "sort_order": 8,
      "revision": 1
    },
    {
      "id": "d2000006-0000-4000-8000-000000000006",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "CI/CD",
      "intl": "Continuous Integration / Continuous Delivery",
      "cn": "持續整合 / 持續交付",
      "description": "透過自動化構建、測試、掃描和部署，使代碼變更能持續驗證與交付。Agent 生成代碼後仍應進入同一品質門禁，而不是繞過工程流程。",
      "sort_order": 9,
      "revision": 1
    },
    {
      "id": "d2000007-0000-4000-8000-000000000007",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Code Review",
      "intl": "AI-assisted Code Review",
      "cn": "代碼審查",
      "description": "檢查變更的正確性、可維護性、安全性與影響範圍。AI 可輔助定位風險和生成測試，但最終判斷應基於差異、運行證據與專案標準。",
      "sort_order": 10,
      "revision": 1
    },
    {
      "id": "d2000008-0000-4000-8000-000000000008",
      "category_id": "d6436ea1-bdf6-4558-b938-20d20b9e63a9",
      "term": "Agent Observability",
      "intl": "Agent Tracing / Observability",
      "cn": "智能體可觀測性",
      "description": "記錄提示、工具調用、文件修改、測試結果、耗時與錯誤，以便重現和評估 Agent 行為。生產指標應同時關注任務成功率、回歸、成本與人工接管率。",
      "sort_order": 11,
      "revision": 1
    },
    {
      "id": "ad668fbd-6d7b-4746-b541-7af221b96edf",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Diffusion Models",
      "intl": "Stable Diffusion、Midjourney、Adobe Firefly",
      "cn": "擴散生成模型；可靈、即夢、通義萬相",
      "description": "學習逐步逆轉加噪過程，從隨機噪聲生成圖像或影片的模型家族。擴散描述的是生成方法，不能把 Midjourney、Stable Diffusion、可靈等不同產品直接視為同一底層架構。",
      "sort_order": 0,
      "revision": 1
    },
    {
      "id": "a19772fa-bb46-4417-8678-954d24a111e6",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Node-based Workflow",
      "intl": "ComfyUI、InvokeAI",
      "cn": "節點式工作流；LiblibAI、吐司 TusiArt",
      "description": "以節點和連線組合模型載入、條件控制、採樣、後處理與輸出的可視化工作流。它提升可重用性與可調試性，但不改變底層模型本身的能力與限制。",
      "sort_order": 1,
      "revision": 1
    },
    {
      "id": "3cf8fbce-6a25-42c8-878d-170ba069dcf3",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Video Generation",
      "intl": "Sora、Veo、Runway",
      "cn": "影片生成；可靈、Vidu、即夢",
      "description": "由文字、圖像或影片條件生成新影片的模型與產品類別。常見系統把壓縮後的時空片段作為序列建模，但產品實作並不完全相同；核心難點包括時序一致性、運動合理性與可控性。",
      "sort_order": 2,
      "revision": 1
    },
    {
      "id": "d3000001-0000-4000-8000-000000000001",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Latent Diffusion",
      "intl": "Stable Diffusion、DreamStudio、ComfyUI",
      "cn": "潛空間擴散模型；LiblibAI、吐司 TusiArt",
      "description": "先用編碼器把圖像壓縮到潛空間，再在較低維表示上執行擴散生成，最後解碼為圖像。這能顯著降低高解析度生成的計算成本，但壓縮也可能損失細節。",
      "sort_order": 3,
      "revision": 1
    },
    {
      "id": "d3000002-0000-4000-8000-000000000002",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "DiT",
      "intl": "Stable Diffusion 3、FLUX.1、Sora",
      "cn": "擴散 Transformer；可靈、通義萬相、騰訊混元",
      "description": "以 Transformer 取代傳統 U-Net 作為擴散模型骨幹，對潛空間圖像或影片片段進行建模。其優勢是易於擴展算力與模型規模，已成為多類生成系統的重要架構。",
      "sort_order": 4,
      "revision": 1
    },
    {
      "id": "d3000003-0000-4000-8000-000000000003",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Flow Matching",
      "intl": "FLUX.1、Stable Diffusion 3、ComfyUI",
      "cn": "流匹配 / 校正流；通義萬相、騰訊混元、LiblibAI",
      "description": "學習把噪聲分佈沿連續路徑運輸到資料分佈的向量場方法，可用較少步數進行生成。它與擴散相關但並非同義，實際品質和速度取決於訓練與採樣設計。",
      "sort_order": 5,
      "revision": 1
    },
    {
      "id": "d3000004-0000-4000-8000-000000000004",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Text-to-Image",
      "intl": "Midjourney、Adobe Firefly、ChatGPT Images",
      "cn": "文生圖；即夢、通義萬相、文心一格",
      "description": "根據文字提示生成圖像的任務。效果受提示理解、訓練資料、構圖能力與解碼品質影響；涉及品牌、人物或商用素材時還需考慮版權、肖像權與來源標註。",
      "sort_order": 6,
      "revision": 1
    },
    {
      "id": "d3000005-0000-4000-8000-000000000005",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Image-to-Image",
      "intl": "Midjourney Editor、Adobe Firefly、Runway",
      "cn": "圖生圖 / 圖像編輯；可靈、即夢、通義萬相",
      "description": "以參考圖像配合文字或其他條件生成新圖，用於風格轉換、局部修改、姿態保持和版本探索。輸出與原圖的一致程度取決於條件強度和模型編輯能力。",
      "sort_order": 7,
      "revision": 1
    },
    {
      "id": "d3000006-0000-4000-8000-000000000006",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "Inpainting & Outpainting",
      "intl": "Midjourney Editor、Photoshop Generative Fill、Clipdrop",
      "cn": "局部重繪 / 畫面擴展；即夢、通義萬相、LiblibAI",
      "description": "Inpainting 在遮罩區域內重建或替換內容；Outpainting 則向畫布外延伸場景。高品質結果需要兼顧邊界融合、光影、透視與主體一致性。",
      "sort_order": 8,
      "revision": 1
    },
    {
      "id": "d3000007-0000-4000-8000-000000000007",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "ControlNet",
      "intl": "ComfyUI、Stable Diffusion WebUI、Hugging Face",
      "cn": "空間條件控制；LiblibAI、吐司 TusiArt",
      "description": "在預訓練文生圖模型上加入邊緣、深度、姿態、分割等空間條件，使構圖更可控。它提升約束能力，但不保證身份、材質或細節完全一致。",
      "sort_order": 9,
      "revision": 1
    },
    {
      "id": "d3000008-0000-4000-8000-000000000008",
      "category_id": "fd1a19f7-5c41-4dca-9c1f-5113be2eb186",
      "term": "LoRA",
      "intl": "Civitai、Hugging Face、ComfyUI",
      "cn": "低秩適配；LiblibAI、吐司 TusiArt",
